{
  "openapi": "3.2.0",
  "info": {
    "title": "CDD Control Plane (cdd-control-plane)",
    "version": "0.1.0",
    "description": "OpenAPI 3.2.0 specification for cdd-control-plane /api/v1 endpoints."
  },
  "servers": [
    {
      "url": "http://localhost:8086",
      "description": "CDD Unified Ingress (cdd-ops)"
    }
  ],
  "tags": [
    {
      "name": "api",
      "description": "ApiService HTTP client operations"
    },
    {
      "name": "artifactStorage",
      "description": "ArtifactStorageService HTTP client operations"
    },
    {
      "name": "mcpRpc",
      "description": "McpRpcService JSON-RPC 2.0 and MCP HTTP client operations"
    }
  ],
  "paths": {

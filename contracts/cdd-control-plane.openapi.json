{
  "openapi": "3.2.0",
  "info": {
    "title": "CDD Control Plane (cdd-control-plane)",
    "version": "0.1.0",
    "description": "OpenAPI 3.2.0 specification for cdd-control-plane /api/v1 endpoints."
  },
  "servers": [
    {
      "url": "http://localhost:8086",
      "description": "CDD Unified Ingress (cdd-ops)"
    }
  ],
  "tags": [
    {
      "name": "api",
      "description": "ApiService HTTP client operations"
    },
    {
      "name": "artifactStorage",
      "description": "ArtifactStorageService HTTP client operations"
    },
    {
      "name": "mcpRpc",
      "description": "McpRpcService JSON-RPC 2.0 and MCP HTTP client operations"
    }
  ],
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": ["api"],
        "operationId": "checkControlPlaneHealth",
        "summary": "Check Control Plane health",
        "responses": {
          "200": {
            "description": "Control Plane is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "tags": ["api"],
        "operationId": "registerControlPlane",
        "summary": "Register a new user in Control Plane",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterPayload"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User registered",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": ["api"],
        "operationId": "loginControlPlane",
        "summary": "Authenticate user in Control Plane",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginPayload"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "delete": {
        "tags": ["api"],
        "operationId": "deleteAccount",
        "summary": "Delete authenticated user account",
        "security": [
          {
            "bearer_auth": []
          }
        ],
        "responses": {
          "204": {
            "description": "Account deleted"
          }
        }
      }
    },
    "/api/v1/orgs": {
      "get": {
        "tags": ["api"],
        "operationId": "listOrgs",
        "summary": "List organizations for authenticated user",
        "security": [
          {
            "bearer_auth": []
          }
        ],
        "responses": {
          "200": {
            "description": "List of organizations",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Organization"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["api"],
        "operationId": "createControlPlaneOrg",
        "summary": "Create organization in Control Plane",
        "security": [
          {
            "bearer_auth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOrgPayload"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Organization created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Organization"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/orgs/{id}": {
      "get": {
        "tags": ["api"],
        "operationId": "getOrg",
        "summary": "Get organization by ID",
        "security": [
          {
            "bearer_auth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Organization details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Organization"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["api"],
        "operationId": "deleteOrg",
        "summary": "Delete organization by ID",
        "security": [
          {
            "bearer_auth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Organization deleted"
          }
        }
      }
    },
    "/api/v1/orgs/{id}/members": {
      "post": {
        "tags": ["api"],
        "operationId": "inviteOrgMember",
        "summary": "Invite a user to an organization with RBAC role",
        "security": [
          {
            "bearer_auth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InviteMemberPayload"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Member invited"
          }
        }
      }
    },
    "/api/v1/orgs/{org_id}/repos": {
      "get": {
        "tags": ["api"],
        "operationId": "listRepos",
        "summary": "List repositories in an organization",
        "security": [
          {
            "bearer_auth": []
          }
        ],
        "parameters": [
          {
            "name": "org_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of repositories",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Repository"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["api"],
        "operationId": "createOrgRepo",
        "summary": "Create a repository in an organization",
        "security": [
          {
            "bearer_auth": []
          }
        ],
        "parameters": [
          {
            "name": "org_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRepoPayload"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Repository created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Repository"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/orgs/{org_id}/repos/{repo_id}": {
      "get": {
        "tags": ["api"],
        "operationId": "getRepo",
        "summary": "Get repository by ID",
        "security": [
          {
            "bearer_auth": []
          }
        ],
        "parameters": [
          {
            "name": "org_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "repo_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Repository details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Repository"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["api"],
        "operationId": "deleteRepo",
        "summary": "Delete repository by ID",
        "security": [
          {
            "bearer_auth": []
          }
        ],
        "parameters": [
          {
            "name": "org_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "repo_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Repository deleted"
          }
        }
      }
    },
    "/api/v1/orgs/{org_id}/repos/{repo_id}/releases": {
      "get": {
        "tags": ["api"],
        "operationId": "listReleases",
        "summary": "List SDK releases for a repository",
        "security": [
          {
            "bearer_auth": []
          }
        ],
        "parameters": [
          {
            "name": "org_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "repo_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of releases",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Release"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["api"],
        "operationId": "createOrgRelease",
        "summary": "Create an SDK release and enqueue ReleaseSdkJob for cdd-publisher",
        "security": [
          {
            "bearer_auth": []
          }
        ],
        "parameters": [
          {
            "name": "org_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "repo_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateReleasePayload"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Release created and queued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Release"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tokens": {
      "get": {
        "tags": ["api"],
        "operationId": "listTokens",
        "summary": "List configured encrypted token providers",
        "security": [
          {
            "bearer_auth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Configured token providers",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TokenProvider"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["api"],
        "operationId": "storeToken",
        "summary": "Encrypt and store a provider token with AES-256-GCM",
        "security": [
          {
            "bearer_auth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StoreTokenPayload"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token stored",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tokens/{provider}": {
      "delete": {
        "tags": ["api"],
        "operationId": "deleteToken",
        "summary": "Delete stored token for provider",
        "security": [
          {
            "bearer_auth": []
          }
        ],
        "parameters": [
          {
            "name": "provider",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/TokenProvider"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Token deleted"
          }
        }
      }
    },
    "/api/v1/orgs/{org_id}/audit": {
      "get": {
        "tags": ["api"],
        "operationId": "listAuditLogs",
        "summary": "List paginated audit logs for an organization",
        "security": [
          {
            "bearer_auth": []
          }
        ],
        "parameters": [
          {
            "name": "org_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated audit log records",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AuditLogRecord"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/audit/publish": {
      "post": {
        "tags": ["api"],
        "operationId": "reportPublishAudit",
        "summary": "Record SDK package publishing telemetry from cdd-publisher",
        "security": [
          {
            "bearer_auth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PublishAuditPayload"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Publish audit telemetry recorded"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer_auth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          }
        }
      },
      "VersionResponse": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          },
          "gateway": {
            "type": "string"
          },
          "ecosystem": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "RegisterPayload": {
        "type": "object",
        "required": ["username", "email"],
        "properties": {
          "username": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "LoginPayload": {
        "type": "object",
        "required": ["username"],
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "OAuthPayload": {
        "type": "object",
        "required": ["code"],
        "properties": {
          "code": {
            "type": "string"
          }
        }
      },
      "AuthResponse": {
        "type": "object",
        "required": ["token"],
        "properties": {
          "token": {
            "type": "string"
          }
        }
      },
      "OrgRole": {
        "type": "string",
        "enum": ["owner", "admin", "member"]
      },
      "Organization": {
        "type": "object",
        "required": ["id", "login"],
        "properties": {
          "id": {
            "type": "integer"
          },
          "github_id": {
            "type": "integer",
            "nullable": true
          },
          "login": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "CreateOrgPayload": {
        "type": "object",
        "required": ["login"],
        "properties": {
          "login": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "InviteMemberPayload": {
        "type": "object",
        "required": ["email", "role"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "role": {
            "$ref": "#/components/schemas/OrgRole"
          }
        }
      },
      "Repository": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": {
            "type": "integer"
          },
          "organization_id": {
            "type": "integer"
          },
          "github_id": {
            "type": "integer",
            "nullable": true
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "CreateRepoPayload": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "organization_id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "Release": {
        "type": "object",
        "required": ["id", "repository_id", "tag_name"],
        "properties": {
          "id": {
            "type": "integer"
          },
          "repository_id": {
            "type": "integer"
          },
          "github_id": {
            "type": "integer",
            "nullable": true
          },
          "tag_name": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "body": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "CreateReleasePayload": {
        "type": "object",
        "required": ["tag_name"],
        "properties": {
          "tag_name": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "body": {
            "type": "string"
          }
        }
      },
      "TokenProvider": {
        "type": "string",
        "enum": ["github", "npm", "pypi", "cargo"]
      },
      "StoreTokenPayload": {
        "type": "object",
        "required": ["provider", "token"],
        "properties": {
          "provider": {
            "$ref": "#/components/schemas/TokenProvider"
          },
          "token": {
            "type": "string"
          }
        }
      },
      "AuditActionType": {
        "type": "string",
        "enum": [
          "org_created",
          "member_added",
          "repo_created",
          "release_created",
          "token_stored",
          "token_deleted",
          "sdk_generated",
          "sdk_published",
          "publish_failed"
        ]
      },
      "AuditLogRecord": {
        "type": "object",
        "required": ["id", "org_id", "user_id", "action", "timestamp"],
        "properties": {
          "id": {
            "type": "integer"
          },
          "org_id": {
            "type": "integer"
          },
          "repo_id": {
            "type": "integer",
            "nullable": true
          },
          "user_id": {
            "type": "integer"
          },
          "action": {
            "$ref": "#/components/schemas/AuditActionType"
          },
          "metadata_json": {
            "type": "object",
            "nullable": true,
            "additionalProperties": true
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PublishAuditPayload": {
        "type": "object",
        "required": ["artifact_id", "registry", "success"],
        "properties": {
          "artifact_id": {
            "type": "string"
          },
          "registry": {
            "type": "string",
            "enum": ["npm", "pypi", "cargo"]
          },
          "success": {
            "type": "boolean"
          },
          "error_message": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "SyncStatus": {
        "type": "object",
        "required": ["success", "message"],
        "properties": {
          "success": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "WebhookResponse": {
        "type": "object",
        "required": ["success"],
        "properties": {
          "success": {
            "type": "boolean"
          }
        }
      },
      "GithubReleasePayload": {
        "type": "object",
        "required": ["owner", "repo", "tag_name"],
        "properties": {
          "owner": {
            "type": "string"
          },
          "repo": {
            "type": "string"
          },
          "tag_name": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "body": {
            "type": "string"
          }
        }
      },
      "TriggerWorkflowPayload": {
        "type": "object",
        "required": ["owner", "repo", "workflow_id", "ref_branch"],
        "properties": {
          "owner": {
            "type": "string"
          },
          "repo": {
            "type": "string"
          },
          "workflow_id": {
            "type": "string"
          },
          "ref_branch": {
            "type": "string"
          }
        }
      },
      "CreateGithubSecretPayload": {
        "type": "object",
        "required": ["owner", "repo", "secret_name", "secret_value"],
        "properties": {
          "owner": {
            "type": "string"
          },
          "repo": {
            "type": "string"
          },
          "secret_name": {
            "type": "string"
          },
          "secret_value": {
            "type": "string"
          }
        }
      },
      "JsonRpcRequest": {
        "type": "object",
        "required": ["jsonrpc", "id", "method"],
        "properties": {
          "jsonrpc": {
            "type": "string",
            "enum": ["2.0"]
          },
          "id": {
            "oneOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ]
          },
          "method": {
            "type": "string"
          },
          "params": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "JsonRpcError": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },

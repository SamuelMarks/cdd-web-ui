  "components": {
    "securitySchemes": {
      "bearer_auth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          }
        }
      },
      "VersionResponse": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          },
          "gateway": {
            "type": "string"
          },
          "ecosystem": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "RegisterPayload": {
        "type": "object",
        "required": ["username", "email"],
        "properties": {
          "username": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "LoginPayload": {
        "type": "object",
        "required": ["username"],
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "OAuthPayload": {
        "type": "object",
        "required": ["code"],
        "properties": {
          "code": {
            "type": "string"
          }
        }
      },
      "GoogleLoginPayload": {
        "type": "object",
        "required": ["code"],
        "properties": {
          "code": {
            "type": "string"
          },
          "redirect_uri": {
            "type": "string"
          }
        }
      },
      "ConnectGithubPayload": {
        "type": "object",
        "required": ["code"],
        "properties": {
          "code": {
            "type": "string"
          }
        }
      },
      "ConnectGooglePayload": {
        "type": "object",
        "required": ["code"],
        "properties": {
          "code": {
            "type": "string"
          },
          "redirect_uri": {
            "type": "string"
          }
        }
      },
      "ConnectPasswordPayload": {
        "type": "object",
        "required": ["password"],
        "properties": {
          "password": {
            "type": "string"
          }
        }
      },
      "AuthMethod": {
        "type": "string",
        "enum": ["password", "github", "google"]
      },
      "AuthenticatedUserProfile": {
        "type": "object",
        "required": ["id", "username", "email", "github_linked", "google_linked", "has_password"],
        "properties": {
          "id": {
            "oneOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ]
          },
          "username": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "name": {
            "type": "string"
          },
          "avatar_url": {
            "type": "string",
            "nullable": true
          },
          "github_linked": {
            "type": "boolean"
          },
          "google_linked": {
            "type": "boolean"
          },
          "has_password": {
            "type": "boolean"
          }
        }
      },
      "GitHubOrg": {
        "type": "object",
        "required": ["id", "login"],
        "properties": {
          "id": {
            "type": "integer"
          },
          "login": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "avatar_url": {
            "type": "string",
            "nullable": true
          },
          "is_personal": {
            "type": "boolean"
          }
        }
      },
      "RepoTopologyMode": {
        "type": "string",
        "enum": ["monorepo", "polyrepo"]
      },
      "PackageRegistryId": {
        "type": "string",
        "enum": [
          "npm",
          "pypi",
          "cargo",
          "maven",
          "nuget",
          "rubygems",
          "packagist",
          "pkggodev",
          "swift",
          "vcpkg",
          "conan",
          "homebrew",
          "github_releases"

{
  "name": "cdd-web-ui",
  "version": "0.0.2",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "prestart": "npm run build:wasm",
    "start": "ng serve --port 8083",
    "prebuild": "npm run build:wasm",
    "build": "ng build",
    "prebuild:prod": "npm run build:wasm",
    "build:prod": "ng build --configuration production",
    "prebuild:dev": "npm run build:wasm",
    "build:dev": "ng build --configuration development",
    "prebuild:c-only": "npm run build:wasm",
    "build:c-only": "ng build --configuration c-only",
    "serve:c-only": "ng serve --configuration c-only --port 8083",
    "watch": "ng build --watch --configuration development",
    "test": "vitest run",
    "e2e": "playwright test",
    "preinstall": "bash scripts/setup-deps.sh",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky || echo 'To fix precommit hooks after git clean -fdx, run: npx husky && npm i'",
    "doc": "compodoc -p tsconfig.json",
    "doc:coverage": "node scripts/check-doc-coverage.mjs && compodoc -p tsconfig.json --coverageTest 100",
    "test:coverage": "vitest run --coverage",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:wasm:local": "node scripts/build-wasm.mjs --local",
    "deploy:gh": "npx angular-cli-ghpages --dir=dist/cdd-web-ui/browser"
  },
  "private": true,
  "packageManager": "npm@12.2.1",
  "overrides": {
    "ngx-monaco-editor-v2": {
      "monaco-editor": "$monaco-editor"
    }
  },
  "dependencies": {
    "@angular/animations": "^22.2",
    "@angular/cdk": "^22.2",
    "@angular/common": "^22.2",
    "@angular/compiler": "^22.2",
    "@angular/core": "^22.2",
    "@angular/forms": "^22.2",
    "@angular/localize": "^22.2",
    "@angular/material": "^22.2",
    "@angular/platform-browser": "^22.2",
    "@angular/router": "^22.2",
    "@bjorn3/browser_wasi_shim": "^0.4",
    "@modelcontextprotocol/sdk": "^1.32",
    "@ngrx/effects": "^22.0",
    "@ngrx/store": "^22.0",
    "@ngrx/store-devtools": "^22.0",
    "@sentry/angular": "^11.9",
    "@sentry/tracing": "^7.120",
    "@types/d3": "^7.4",
    "cdd-browser-sdk": "file:../cdd-browser-sdk",
    "cdd-docs-ui": "file:../cdd-docs-ui",
    "d3": "^7.9",
    "js-yaml": "^5.5",
    "monaco-editor": "^0.57",
    "ngx-monaco-editor-v2": "^22.0",
    "rxjs": "^7.8",
    "tslib": "^2.8"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.9",
    "@angular-eslint/builder": "^22.6",
    "@angular-eslint/eslint-plugin": "^22.6",
    "@angular-eslint/eslint-plugin-template": "^22.6",
    "@angular-eslint/schematics": "^22.6",
    "@angular-eslint/template-parser": "^22.6",
    "@angular/build": "^22.2",
    "@angular/cli": "^22.2",
    "@angular/compiler-cli": "^22.2",
    "@angular/platform-browser-dynamic": "^22.2",
    "@compodoc/compodoc": "^2.0",
    "@eslint/js": "^10.0",
    "@playwright/test": "^1.64",
    "@types/js-yaml": "^4.0",
    "@typescript-eslint/eslint-plugin": "^8.72",
    "@typescript-eslint/parser": "^8.72",
    "@vitest/browser-playwright": "^5.0",
    "@vitest/coverage-istanbul": "^5.0",
    "@vitest/coverage-v8": "^5.0",
    "angular-cli-ghpages": "^3.1",
    "eslint": "^10.13",
    "husky": "^9.1",
    "jsdom": "^30.1",
    "playwright": "^1.64",
    "prettier": "^3.9",
    "typescript": "^6.0",
    "typescript-eslint": "^8.72",
    "vite": "^8.3",
    "vitest": "^5.0",
    "zone.js": "^0.16"
  }
}
